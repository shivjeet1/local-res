{
  "compilerOptions": {
    "target":          "ES2022",
    "module":          "NodeNext",
    "moduleResolution":"NodeNext",
    "lib":             ["ES2022"],
    "outDir":          "./dist",
    "rootDir":         "./src",
    "strict":          true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck":    true,
    "declaration":     true,
    "sourceMap":       true,
    "paths": {
      "@local-res/shared": ["../packages/shared/src/index.js", "../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
